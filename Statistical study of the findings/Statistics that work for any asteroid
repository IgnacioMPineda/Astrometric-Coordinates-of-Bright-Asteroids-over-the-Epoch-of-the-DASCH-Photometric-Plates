    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# Julian dates are in column -3 (from your data structure)\n",
    "julian_dates = np.array([float(row[-3]) for row in data])\n",
    "\n",
    "# Convert JD to calendar year\n",
    "years = (julian_dates - 2451545.0) / 365.25 + 2000\n",
    "\n",
    "# Keep reasonable range (optional but cleaner)\n",
    "years = years[(years >= 1900) & (years <= 2030)]\n",
    "\n",
    "# Decade bins\n",
    "bins = np.arange(1900, 2040, 10)\n",
    "\n",
    "plt.figure(figsize=(10,6))\n",
    "plt.hist(years, bins=bins, edgecolor='black')\n",
    "\n",
    "plt.xlabel(\"Year\")\n",
    "plt.ylabel(\"Number of observations\")\n",
    "plt.title(\"Asteroid observations through decades\")\n",
    "\n",
    "plt.xticks(bins, rotation=45)\n",
    "plt.show()"
   ]
